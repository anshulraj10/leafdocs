# LeafDocs configuration
# Copy this to .env and fill in values

# Optional: comma-separated pins for authentication
# Leave empty or unset for an open (no-auth) server
LEAFDOCS_PINS=

# Optional: Flask secret key for session signing
# If unset, a random key is generated at startup (sessions invalidated on restart)
# LEAFDOCS_SECRET_KEY=your-secret-key-here

# Optional: send the session cookie with the Secure flag (default: true)
# Set to false only when serving over plain HTTP (e.g. raw-IP testing),
# otherwise browsers drop the cookie and login loops back to the login page
# LEAFDOCS_COOKIE_SECURE=true

# Optional: skip HTML sanitizing of rendered Markdown (default: false)
# Warning: only safe when you are the sole author of all content in docs/
# LEAFDOCS_ALLOW_HTML=false
