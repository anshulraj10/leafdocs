# LeafDocs configuration
# Copy this to .env and fill in values

# Optional: comma-separated pins for authentication
# Leave empty or unset for an open (no-auth) server
LEAFDOCS_PINS=

# Optional: Flask secret key for session signing
# If unset, a random key is generated at startup (sessions invalidated on restart)
# LEAFDOCS_SECRET_KEY=your-secret-key-here
